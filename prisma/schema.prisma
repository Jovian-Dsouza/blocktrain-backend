// PostgreSQL version of the schema with proper enum support
// To use this, rename it to schema.prisma and update your DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TradeType {
  BUY
  SELL
}

model TelegramUser {
  id        String   @id @default(uuid())
  chatId    String   @unique
  username  String?
  firstName String?
  lastName  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  walletSubscriptions WalletSubscription[]

  @@map("telegram_users")
}

model WalletSubscription {
  id            String        @id @default(uuid())
  telegramUserId String
  walletAddress String
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  telegramUser TelegramUser @relation(fields: [telegramUserId], references: [id], onDelete: Cascade)

  @@unique([telegramUserId, walletAddress])
  @@map("wallet_subscriptions")
}

model Wallet {
  id          String   @id @default(uuid())
  address     String   @unique
  name        String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  events Event[]

  @@map("wallets")
}

model Event {
  id            String    @id @default(uuid())
  walletAddress String
  walletId      String?   // Reference to tracked wallet
  token1        String    // Primary token address
  amount1       Float?    // Primary token amount
  token2        String?   // Secondary token address (optional)
  amount2       Float?    // Secondary token amount (optional)
  tradeType     TradeType
  priceAt       Float?
  tradedAt      DateTime  @default(now())
  notified      Boolean   @default(false) // Track if notification was sent

  // Relations
  wallet Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

  @@map("events")
}
